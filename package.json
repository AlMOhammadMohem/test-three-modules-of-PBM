{
      "name": "pbm-automation",
      "version": "1.0.0",
      "description": "Playwright + TypeScript automation framework for the PBM application (Payer Management and Network Management modules)",
      "private": true,
      "scripts": {
              "test": "playwright test",
              "test:headed": "playwright test --headed",
              "test:debug": "playwright test --debug",
              "test:ui": "playwright test --ui",
              "test:payer": "playwright test tests/payer-management",
              "test:network": "playwright test tests/network-management",
              "test:parallel": "playwright test --workers=4",
              "test:chromium": "playwright test --project=chromium",
              "report": "playwright show-report reports/html-report",
              "codegen": "playwright codegen",
              "install:browsers": "playwright install",
              "lint": "eslint . --ext .ts",
              "format": "prettier --write ."
      },
      "keywords": [
              "playwright",
              "typescript",
              "automation",
              "qa",
              "pbm"
      ],
      "author": "QA Automation Team",
      "license": "MIT",
      "devDependencies": {
              "@playwright/test": "^1.48.0",
              "@types/node": "^20.14.0",
              "dotenv": "^16.4.5",
              "typescript": "^5.5.4"
      }
}
